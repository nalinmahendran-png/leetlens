{
  "name": "leetlens",
  "version": "0.1.0",
  "private": true,
  "description": "Connect a LeetCode username, see your topic strengths as a solar system, get recommendations, and climb a leaderboard.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push --skip-generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ladder:build": "tsx scripts/build-ladder.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "next": "^15.5.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
