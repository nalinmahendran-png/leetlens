# PostgreSQL connection string. On Vercel, adding a database from the Storage tab (Prisma Postgres
# or Neon) sets it automatically. Locally, point it at any Postgres you run.
DATABASE_URL="postgresql://postgres:pw@localhost:5432/postgres"

# Set to 1 to use built-in FAKE LeetCode data for every username (offline development).
# The username "demo" always uses fake data, even when this is 0.
USE_MOCK_LEETCODE=0

# Secret for the daily sync endpoint (GET /api/cron/sync). Vercel Cron sends it automatically as
# "Authorization: Bearer <CRON_SECRET>". Leave empty to keep the endpoint disabled.
CRON_SECRET=""

# Free Gemini API key for the "Beat this" hints on the Submissions page (https://aistudio.google.com/).
# Hints use Gemini 3.8 Flash. On the free tier it can't use Google Search, so hints come from the
# model's own knowledge; with billing on, it searches the web too (and Google charges for it).
# Leave empty to keep hints off; the rest of the app works without it.
GEMINI_API_KEY=""

# Timezone whose midnight resets "Today's 3" (an IANA name). Empty = the server's own timezone,
# which is wrong on most hosts (they run on UTC), so set it when you deploy.
DAILY_TIMEZONE="Asia/Kolkata"
